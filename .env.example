# Copy to .env — never commit .env

# Required
STEAM_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX  # https://steamcommunity.com/dev/apikey

# Optional
LOG_LEVEL=info            # debug | info | warn | error (default: info)
RATE_LIMIT_RPM=100        # Requests per minute to Steam API (default: 100)
REQUEST_TIMEOUT_MS=10000  # HTTP timeout in ms (default: 10000)
CACHE_TTL_SECONDS=300     # In-memory cache TTL (default: 300)
